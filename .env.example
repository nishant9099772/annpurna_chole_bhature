# ============================================================================
# ANNAPURNA CHOLE BHATURE BILLING APPLICATION — NETLIFY PRODUCTION ENV VARS
# Configure these in Netlify: Site configuration -> Environment variables
# ============================================================================

# 1. MANDATORY — Admin Login & 24h Session Security
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change_me_to_secure_password"
ADMIN_JWT_SECRET="annpurna_jwt_secret_key_minimum_32_chars_random"

# 2. MANDATORY — Direct Google Sheets API (Primary Production Database)
# Share your Google Sheet (Editor permission) with GOOGLE_SERVICE_ACCOUNT_EMAIL
GOOGLE_SHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# 3. OPTIONAL — Official Meta WhatsApp Business Cloud API (Automatic Sending)
# Leave blank to use automatic Click-to-Chat (wa.me) fallback with +91 8800896679
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# 4. LOCAL / AI STUDIO PREVIEW ONLY (Not needed in Netlify Dashboard)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
PORT=3000

