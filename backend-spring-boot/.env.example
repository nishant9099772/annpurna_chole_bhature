# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
ADMIN_JWT_SECRET=super_secret_jwt_random_key_min_32_characters

# Google Sheets Configuration
# Target Spreadsheet ID (from https://docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here
# Path to Google Service Account JSON credentials (or use Bearer token header)
GOOGLE_CREDENTIALS_PATH=/path/to/service-account.json

# Server Port
PORT=8080
